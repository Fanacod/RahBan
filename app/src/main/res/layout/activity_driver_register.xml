<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FBFC"
    android:layoutDirection="rtl">

    <ScrollView
        android:id="@+id/registerScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="30dp">




            <!-- Intro Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#09564E"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="#09564E"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="17dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_bus_icon">

                        <ImageView
                            android:layout_width="31dp"
                            android:layout_height="31dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_driver"
                            app:tint="#CC0136"
                            android:contentDescription="راننده"/>

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="13dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="به خانواده راه‌بان بپیوندید"
                            android:textColor="#ffffff"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="اطلاعات شما برای بررسی و تأیید حساب راننده استفاده می‌شود."
                            android:textColor="#CFE9F0"
                            android:textSize="11sp"
                            android:lineSpacingExtra="2dp"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= PERSONAL ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_tab_selected"/>

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_marginStart="9dp"
                    android:src="@drawable/ic_user_id"
                    app:tint="#009688"
                    android:contentDescription="اطلاعات شخصی"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="اطلاعات شخصی"
                    android:textColor="#123B4A"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- Full Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutFullName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="نام و نام خانوادگی"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusTopStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxStrokeColor="#C4D1D5"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#526A71">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtFullName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="textPersonName"
                    android:textColor="#123B4A"
                    android:textColorHint="#526A71"
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- National ID -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutNationalId"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="کد ملی"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusTopStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxStrokeColor="#C4D1D5"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#526A71">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNationalId"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="number"
                    android:maxLength="10"
                    android:textColor="#123B4A"
                    android:textColorHint="#526A71"
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Mobile -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutMobile"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="شماره موبایل"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusTopStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxStrokeColor="#C4D1D5"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#526A71">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtMobile"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="phone"
                    android:maxLength="11"
                    android:textColor="#123B4A"
                    android:textColorHint="#526A71"
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================= DRIVING ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_tab_selected"/>

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_marginStart="9dp"
                    android:src="@drawable/ic_document"
                    app:tint="#009688"
                    android:contentDescription="اطلاعات رانندگی"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="اطلاعات رانندگی"
                    android:textColor="#123B4A"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- License -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutLicense"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="شماره گواهینامه"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusTopStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxStrokeColor="#C4D1D5"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#526A71">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtLicense"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="number"
                    android:textColor="#123B4A"
                    android:textColorHint="#526A71"
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Experience -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutExperience"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="سابقه رانندگی (سال)"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusTopStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxStrokeColor="#C4D1D5"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#526A71">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtExperience"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="number"
                    android:textColor="#123B4A"
                    android:textColorHint="#526A71"
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Emergency -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutEmergency"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="شماره تماس اضطراری"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusTopStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxStrokeColor="#C4D1D5"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#526A71">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtEmergency"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="phone"
                    android:maxLength="11"
                    android:textColor="#123B4A"
                    android:textColorHint="#526A71"
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================= VEHICLE ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_tab_selected"/>

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_marginStart="9dp"
                    android:src="@drawable/car_svgrepo_com"
                    app:tint="#009688"
                    android:contentDescription="اطلاعات خودرو"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="اطلاعات خودرو"
                    android:textColor="#123B4A"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- Vehicle Type -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutVehicleType"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="نوع خودرو"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusTopStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxStrokeColor="#C4D1D5"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#526A71">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtVehicleType"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="text"
                    android:textColor="#123B4A"
                    android:textColorHint="#526A71"
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Vehicle Model -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutVehicleModel"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="مدل خودرو"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusTopStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxStrokeColor="#C4D1D5"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#526A71">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtVehicleModel"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="text"
                    android:textColor="#123B4A"
                    android:textColorHint="#526A71"
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Vehicle Color -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutVehicleColor"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="رنگ خودرو"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusTopStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxStrokeColor="#C4D1D5"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#526A71">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtVehicleColor"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="text"
                    android:textColor="#123B4A"
                    android:textColorHint="#526A71"
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Plate -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutPlate"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="شماره پلاک"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusTopStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxStrokeColor="#C4D1D5"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#526A71">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPlate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="text"
                    android:textColor="#123B4A"
                    android:textColorHint="#526A71"
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Capacity -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutCapacity"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="ظرفیت خودرو"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusTopStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxStrokeColor="#C4D1D5"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#526A71">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtCapacity"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="number"
                    android:textColor="#123B4A"
                    android:textColorHint="#526A71"
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================= SERVICE ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_tab_selected"/>

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_marginStart="9dp"
                    android:src="@drawable/ic_route"
                    app:tint="#009688"
                    android:contentDescription="اطلاعات سرویس"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="اطلاعات سرویس"
                    android:textColor="#123B4A"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- Area -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutArea"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="منطقه فعالیت"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusTopStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxStrokeColor="#C4D1D5"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#526A71">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtArea"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="text"
                    android:textColor="#123B4A"
                    android:textColorHint="#526A71"
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Route -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRoute"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="مسیر پیشنهادی سرویس"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusTopStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxStrokeColor="#C4D1D5"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#526A71">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtRoute"
                    android:layout_width="match_parent"
                    android:layout_height="84dp"
                    android:gravity="start|top"
                    android:inputType="textMultiLine"
                    android:textColor="#123B4A"
                    android:textColorHint="#526A71"
                    android:textSize="14sp"
                    android:paddingTop="14dp"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Agreement -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#DCE7E9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <CheckBox
                        android:id="@+id/checkAgreement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#0FA69A"/>

                    <TextView
                        android:id="@+id/txtAgreement"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="اطلاعات واردشده صحیح است و با بررسی و تأیید حساب راننده موافقم."
                        android:textColor="#526A71"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:gravity="right"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- Register Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegisterDriver"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="15dp"
                android:text="ثبت‌نام و ارسال برای بررسی"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#009688"
                app:cornerRadius="15dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart"
                app:iconTint="@android:color/white"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:gravity="center"
                android:text="پس از بررسی اطلاعات، نتیجه تأیید حساب به شما اطلاع داده می‌شود."
                android:textColor="#7A9197"
                android:textSize="11sp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>