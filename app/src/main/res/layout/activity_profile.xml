<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4FBFC"
        android:layoutDirection="rtl">


        <!-- HEADER -->
        <include
            android:id="@+id/headerLayout"
            layout="@layout/layout_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />



        <!-- Scroll Content -->
        <ScrollView
            android:id="@+id/profileScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">


                <!-- ================= اطلاعات والد ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/parentProfileCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E1EEF0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="18dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/txtDriverAvatar"
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:src="@drawable/ic_parents"
                            android:scaleType="centerCrop"
                            android:contentDescription="تصویر راننده"
                            app:shapeAppearanceOverlay="@style/CircleImageView" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:id="@+id/txtParentName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="فاطمه احمدی"
                                android:textColor="#123B4A"
                                android:textSize="18sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/txtPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="0912••••567"
                                android:textColor="#52717A"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/txtRole"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="والد"
                                android:textColor="#0FA69A"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- عنوان دانش آموز -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp"
                    android:text="دانش‌آموز من"
                    android:textColor="#123B4A"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />


                <!-- ================= دانش آموز ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/studentCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E1EEF0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/txtDriverAvatar"
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:src="@drawable/child"
                            android:scaleType="centerCrop"
                            android:contentDescription="تصویر راننده"
                            app:shapeAppearanceOverlay="@style/CircleImageView" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="13dp">

                            <TextView
                                android:id="@+id/txtStudentName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="سارا احمدی"
                                android:textColor="#123B4A"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/txtStudentInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="پایه هفتم • دبیرستان مهر"
                                android:textColor="#52717A"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================= سرویس فعال ================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp"
                    android:text="سرویس فعال"
                    android:textColor="#123B4A"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/serviceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E1EEF0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="17dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/DriverAvatar"
                                android:layout_width="55dp"
                                android:layout_height="55dp"
                                android:src="@drawable/person_driver"
                                android:scaleType="centerCrop"
                                android:contentDescription="تصویر راننده"
                                app:shapeAppearanceOverlay="@style/CircleImageView" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:id="@+id/txtServiceNumber"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="سرویس شماره ۱۲"
                                    android:textColor="#123B4A"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif-medium" />

                                <TextView
                                    android:id="@+id/txtDriverName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="مهدی رضایی "
                                    android:textColor="#52717A"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtServiceStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="فعال"
                                android:textColor="#fff"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium"
                                android:background="#07C83A"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================= اشتراک ================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp"
                    android:text="اشتراک راه‌بان"
                    android:textColor="#123B4A"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/subscriptionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFF"
                    app:cardCornerRadius="20dp"
                    app:strokeWidth="0dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtSubscriptionTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="اشتراک سالانه ردیابی"
                                    android:textColor="#123B4A"
                                    android:textSize="17sp"
                                    android:fontFamily="sans-serif-medium" />

                                <TextView
                                    android:id="@+id/txtSubscriptionStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="فعال تا ۱۴۰۵/۰۶/۲۲"
                                    android:textColor="#0FA69A"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/txtSubscriptionIcon"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_check_circle"/>

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="15dp"
                            android:layout_marginBottom="13dp"
                            android:background="#CFEAE6" />

                        <TextView
                            android:id="@+id/txtSubscriptionPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="۳۰۰,۰۰۰ تومان • اشتراک سالانه"
                            android:textColor="#123B4A"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/txtSubscriptionDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="ردیابی لحظه‌ای سرویس و اعلان ورود و خروج دانش‌آموز"
                            android:textColor="#52717A"
                            android:textSize="12sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================= setting ================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp"
                    android:text="تنظیمات"
                    android:textColor="#123B4A"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E1EEF0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">


                        <!-- ================= اعلان ها ================= -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="center_vertical"
                            android:paddingStart="5dp"
                            android:paddingEnd="16dp">

                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:padding="3dp"
                                android:src="@drawable/ic_notifications"

                                android:contentDescription="اعلان‌ها"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="1dp"
                                android:text="اعلان‌ها"
                                android:textColor="#123B4A"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchNotifications"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                app:thumbTint="@color/main_color" />

                        </LinearLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EEF4F5"/>


                        <!-- ================= پشتیبانی ================= -->

                        <LinearLayout
                            android:id="@+id/btnSupport"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="3dp"
                                android:src="@drawable/ic_support"
                                android:contentDescription="پشتیبانی"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="1dp"
                                android:text="تماس با پشتیبانی"
                                android:textColor="#123B4A"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_phone"
                                android:tint="@color/main_color"
                                android:contentDescription="ورود به پشتیبانی"/>

                        </LinearLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EEF4F5"/>


                        <!-- ================= خروج ================= -->

                        <LinearLayout
                            android:id="@+id/btnLogout"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="3dp"
                                android:src="@drawable/ic_logout"
                                android:tint="#D85C5C"
                                android:contentDescription="خروج از حساب"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="1dp"
                                android:text="خروج از حساب"
                                android:textColor="#D85C5C"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Version -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="راه‌بان • نسخه 1.0.0"
                    android:textColor="#9AAEB3"
                    android:textSize="11sp"
                    android:layout_marginBottom="10dp" />

            </LinearLayout>

        </ScrollView>


        <!-- Bottom Navigation -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            app:menu="@menu/bottom_nav_menu"
            app:labelVisibilityMode="labeled"
            app:itemIconTint="@color/primary_red"
            app:itemTextColor="@color/primary_red"
            app:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- menu -->
    <include
        android:id="@+id/drawerMenuLayout"
        layout="@layout/drawer_menu"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="right" />
</androidx.drawerlayout.widget.DrawerLayout>

