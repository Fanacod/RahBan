<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    android:layoutDirection="rtl"
    tools:context=".activity_login">

    <!-- ۱. مثلث‌ها (در لایه اصلی می‌مانند تا به گوشه‌ها بچسبند) -->
    <ImageView
        android:id="@+id/triangle_top_left"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:src="@drawable/triangle_top_left"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/triangle_bottom_right"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:src="@drawable/triangle_bottom_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ۲. گایدلاین برای شروع محتوا -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.15" />

    <!-- ۳. لایه اصلی محتوا (Linear Layout) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/topGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgLoginLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_route"
            app:tint="#cc0136"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/txtLoginLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ورود به راهبان"
            android:textColor="#CC0136"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLoginDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="برای ادامه شماره موبایل خود را وارد کنید"
            android:textColor="#757575"
            android:textSize="14sp" />

        <!-- فیلد ورودی شماره -->
        <EditText
            android:id="@+id/edtPhone"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/edit_text_background"
            android:drawableStart="@drawable/hand_holding_mobile_phone_icon"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:hint="09121234567"
            android:inputType="phone"
            android:maxLength="11"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#333333"
            android:textColorHint="#C1BEBE"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="با ادامه، قوانین راهبان را می‌پذیرید."
            android:textColor="#000000"
            android:textSize="12sp" />

        <!-- دکمه -->
        <Button
            android:id="@+id/btnGetCode"
            android:layout_width="250dp"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#CC0136"
            android:text="دریافت کد"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>





    <!-- لایه پس‌زمینه نیمه‌شفاف برای تار کردن فضای پشت -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/otpOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible"

        >

        <!--
         tools:visibility="visible"
         android:visibility="gone"
         این را برای دیدن در پیش‌نمایش موقتاً visible کن -->

        <!-- کارت شیشه‌ای -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            app:cardBackgroundColor="#FBFFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="کد تایید ارسال شده به شماره همراهتان را وارد کنید"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#CC0136" />

                <EditText
                    android:id="@+id/edtOtpCode"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/edit_text_background"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:hint="----"
                    android:inputType="number"
                    android:letterSpacing="0.5"
                    android:maxLength="4"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/btnVerify"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="#CC0136"
                    android:text="تایید و ورود"
                    android:textColor="@android:color/white" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
