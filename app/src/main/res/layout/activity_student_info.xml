<?xml version="1.0" encoding="utf-8"?>


<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4FBFC"
        android:layoutDirection="rtl">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <include
            android:id="@+id/headerLayout"
            layout="@layout/layout_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">


                <!-- عنوان -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="اطلاعات دانش‌آموز"
                    android:textColor="#123B4A"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="برای درخواست سرویس، اطلاعات دانش‌آموز را وارد کنید."
                    android:textColor="#52717A"
                    android:textSize="13sp" />


                <!-- ================================================= -->
                <!-- FORM CARD -->
                <!-- ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E6EEF0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">


                        <!-- نام دانش آموز -->

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="نام و نام خانوادگی دانش‌آموز"
                            android:textColor="#123B4A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilStudentName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxStrokeColor="#CC0136"
                            app:hintEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtStudentName"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:hint="مثلاً علی رضایی"
                                android:inputType="textPersonName"
                                android:textColor="#202020"
                                android:textColorHint="#9AA7AA"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>


                        <!-- ================================================= -->
                        <!-- پایه تحصیلی -->
                        <!-- ================================================= -->

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutRelation"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="پایه تحصیلی">

                            <AutoCompleteTextView
                                android:id="@+id/autoCompleteRelation"
                                android:layout_width="match_parent"
                                android:layout_height="58dp"
                                android:background="@drawable/edit_text_background"
                                android:inputType="none"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#333333"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </com.google.android.material.textfield.TextInputLayout>



                        <!-- ================================================= -->
                        <!-- جنسیت -->
                        <!-- ================================================= -->

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="جنسیت دانش‌آموز"
                            android:textColor="#123B4A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/radioGender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radioBoy"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="پسر"
                                android:textColor="#123B4A"
                                android:textSize="14sp"
                                app:buttonTint="#CC0136" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radioGirl"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="دختر"
                                android:textColor="#123B4A"
                                android:textSize="14sp"
                                app:buttonTint="#CC0136" />

                        </RadioGroup>


                        <!-- ================================================= -->
                        <!-- آدرس منزل -->
                        <!-- ================================================= -->

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="آدرس منزل"
                            android:textColor="#123B4A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardHomeLocation"
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:layout_marginTop="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="#FFF0F3"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#F5D5DD"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="14dp">

                                <ImageView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:padding="9dp"
                                    android:src="@drawable/ic_location"
                                    android:contentDescription="موقعیت منزل" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="12dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/txtLocationTitle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="انتخاب موقعیت منزل"
                                        android:textColor="#123B4A"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/txtLocationStatus"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="برای ثبت آدرس، روی نقشه انتخاب کنید"
                                        android:textColor="#52717A"
                                        android:textSize="12sp" />

                                </LinearLayout>

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/ic_left_arrow"
                                    android:contentDescription="انتخاب موقعیت" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>


                        <!-- ================================================= -->
                        <!-- SAVE -->
                        <!-- ================================================= -->

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveStudent"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="24dp"
                            android:text="ذخیره اطلاعات"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="#CC0136"
                            app:cornerRadius="14dp" />


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


            </LinearLayout>

        </ScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- menu -->
    <include
        android:id="@+id/drawerMenuLayout"
        layout="@layout/drawer_menu"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="right" />

</androidx.drawerlayout.widget.DrawerLayout>
