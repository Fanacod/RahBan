<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tripCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="#DFECEE"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="17dp">

        <!-- عنوان سفر -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgTripIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="@drawable/bg_trip_driver_icon"
                android:src="@drawable/ic_sun"
                android:contentDescription="نوع سفر" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/txtTripService"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="سرویس شماره ۱۲"
                    android:textColor="#123B4A"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/txtSchoolName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="مدرسه فرزانگان"
                    android:textColor="#52717A"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ساعت -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_clock"
                app:tint="#0FA69A"
                android:contentDescription="ساعت" />

            <TextView
                android:id="@+id/txtTripTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="07:00"
                android:textColor="#123B4A"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>


        <!-- مقصد -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_route"
                app:tint="#0FA69A"
                android:contentDescription="مسیر" />

            <TextView
                android:id="@+id/txtTripRoute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="منزل ← مدرسه"
                android:textColor="#123B4A"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- تعداد دانش آموز -->

        <TextView
            android:id="@+id/txtStudentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="33dp"
            android:layout_marginTop="5dp"
            android:text="۱۲ دانش‌آموز"
            android:textColor="#52717A"
            android:textSize="12sp" />


        <!-- وضعیت -->

        <TextView
            android:id="@+id/txtTripStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="12dp"
            android:text="در حال انجام"
            android:textColor="#0FA69A"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_trip_status_active"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>