<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4FBFC"
        android:layoutDirection="rtl">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <include
            android:id="@+id/headerLayout"
            layout="@layout/layout_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="28dp">


                <!-- ================================================= -->
                <!-- STATUS HERO -->
                <!-- ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRequestStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#F3E1E6"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="22dp">


                        <!-- آیکون وضعیت -->

                        <FrameLayout
                            android:layout_width="92dp"
                            android:layout_height="92dp"
                            android:background="@drawable/bg_status_icon">

                            <ImageView
                                android:id="@+id/imgStatusIcon"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_gravity="center"
                                android:contentDescription="وضعیت درخواست"
                                android:src="@drawable/bg_status" />

                        </FrameLayout>


                        <!-- عنوان وضعیت -->

                        <TextView
                            android:id="@+id/txtStatusTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:text="درخواست شما ارسال شد"
                            android:textColor="#123B4A"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />


                        <!-- توضیح وضعیت -->

                        <TextView
                            android:id="@+id/txtStatusDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"
                            android:text="درخواست شما برای راننده ارسال شده و منتظر تأیید هستیم."
                            android:textColor="#52717A"
                            android:textSize="13sp" />


                        <!-- شماره درخواست -->

                        <TextView
                            android:id="@+id/txtRequestNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_request_number"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp"
                            android:text="کد درخواست: ۱۲۵۸"
                            android:textColor="#CC0136"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================================================= -->
                <!-- REQUEST PROGRESS -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/txtProgressTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="مراحل درخواست"
                    android:textColor="#123B4A"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E6EEF0"
                    app:strokeWidth="1dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">


                        <!-- مرحله 1 -->

                        <LinearLayout
                            android:id="@+id/stepSchool"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iconStepSchool"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="مدرسه انتخاب شد"
                                android:src="@drawable/ic_check_circle" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="مدرسه انتخاب شد"
                                    android:textColor="#123B4A"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtStepSchool"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="دبستان و دبیرستان فرزانگان"
                                    android:textColor="#789096"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </LinearLayout>


                        <!-- خط بین مراحل -->

                        <View
                            android:id="@+id/lineStep1"
                            android:layout_width="1dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="14dp"
                            android:background="#DDE7E9" />


                        <!-- مرحله 2 -->

                        <LinearLayout
                            android:id="@+id/stepDriver"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iconStepDriver"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="راننده انتخاب شد"
                                android:src="@drawable/ic_check_circle" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="راننده انتخاب شد"
                                    android:textColor="#123B4A"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtStepDriver"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="مهدی رضایی"
                                    android:textColor="#789096"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </LinearLayout>


                        <View
                            android:id="@+id/lineStep2"
                            android:layout_width="1dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="14dp"
                            android:background="#DDE7E9" />


                        <!-- مرحله 3 -->

                        <LinearLayout
                            android:id="@+id/stepRequest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iconStepRequest"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="درخواست ارسال شد"
                                android:src="@drawable/ic_check_circle" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="درخواست ارسال شد"
                                    android:textColor="#123B4A"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtStepRequest"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="در انتظار پاسخ راننده"
                                    android:textColor="#789096"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </LinearLayout>


                        <View
                            android:id="@+id/lineStep3"
                            android:layout_width="1dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="14dp"
                            android:background="#DDE7E9" />


                        <!-- مرحله 4 -->

                        <LinearLayout
                            android:id="@+id/stepDriverConfirm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iconStepDriverConfirm"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="تأیید راننده"
                                android:src="@drawable/ic_pending" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="تأیید راننده"
                                    android:textColor="#123B4A"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtStepDriverConfirm"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="در انتظار تأیید راننده"
                                    android:textColor="#789096"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </LinearLayout>


                        <View
                            android:id="@+id/lineStep4"
                            android:layout_width="1dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="14dp"
                            android:background="#DDE7E9" />


                        <!-- مرحله 5 -->

                        <LinearLayout
                            android:id="@+id/stepActivation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iconStepActivation"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="فعال سازی سرویس"
                                android:src="@drawable/ic_pending" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="فعال‌سازی سرویس"
                                    android:textColor="#123B4A"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtStepActivation"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="پس از تأیید راننده انجام می‌شود"
                                    android:textColor="#789096"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================================================= -->
                <!-- REQUEST INFORMATION -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/txtInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="اطلاعات درخواست"
                    android:textColor="#123B4A"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRequestInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E6EEF0"
                    app:strokeWidth="1dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">


                        <!-- مدرسه -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_school"
                                android:contentDescription="مدرسه" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="مدرسه"
                                    android:textColor="#789096"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/txtSchool"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="دبستان و دبیرستان فرزانگان"
                                    android:textColor="#123B4A"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="14dp"
                            android:background="#EEF3F4" />


                        <!-- راننده -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/car_svgrepo_com"
                                android:contentDescription="راننده" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="راننده"
                                    android:textColor="#789096"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/txtDriver"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="مهدی رضایی"
                                    android:textColor="#123B4A"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="14dp"
                            android:background="#EEF3F4" />


                        <!-- سرویس -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_bus"
                                android:contentDescription="سرویس" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="سرویس"
                                    android:textColor="#789096"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/txtService"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="سرویس شماره ۱۲"
                                    android:textColor="#123B4A"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================================================= -->
                <!-- CANCEL BUTTON -->
                <!-- ================================================= -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelRequest"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="22dp"
                    android:text="لغو درخواست"
                    android:textColor="#CC0136"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="14dp"
                    app:strokeColor="#CC0136"
                    app:strokeWidth="1dp" />


            </LinearLayout>

        </ScrollView>


        <!-- ================================================= -->
        <!-- BOTTOM NAVIGATION -->
        <!-- ================================================= -->

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:elevation="8dp"
            app:menu="@menu/bottom_nav_menu"
            app:labelVisibilityMode="labeled"
            app:itemIconTint="@color/primary_red"
            app:itemTextColor="@color/primary_red"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- menu -->
    <include
        android:id="@+id/drawerMenuLayout"
        layout="@layout/drawer_menu"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="right" />

</androidx.drawerlayout.widget.DrawerLayout>

