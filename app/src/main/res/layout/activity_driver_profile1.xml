<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="rtl"
        android:background="@color/white">


        <!-- HEADER -->
        <include
            android:id="@+id/headerLayout"
            layout="@layout/layout_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />



        <!-- CONTENT -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">


                <!-- DRIVER HERO CARD -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/driverCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    app:cardBackgroundColor="#FFF0F3"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="22dp">


                        <!-- Avatar -->

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/txtDriverAvatar"
                            android:layout_width="82dp"
                            android:layout_height="82dp"
                            android:src="@drawable/person_driver"
                            android:scaleType="centerCrop"
                            android:contentDescription="تصویر راننده"
                            app:shapeAppearanceOverlay="@style/CircleImageView" />


                        <!-- Driver Name -->

                        <TextView
                            android:id="@+id/txtDriverName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="مهدی رضایی"
                            android:textColor="#202020"
                            android:textSize="21sp"
                            android:textStyle="bold" />


                        <!-- Rating -->

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="#FFFFFF"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp">

                            <TextView
                                android:id="@+id/txtRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="★ ۴.۸ از ۵"
                                android:textColor="#CC0136"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <!-- Car -->

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:src="@drawable/car_svgrepo_com"
                                android:contentDescription="خودرو" />

                            <TextView
                                android:id="@+id/txtCarInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="سمند سفید  •  پلاک ۱۲۳ الف ۴۵"
                                android:textColor="#555555"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- SERVICE INFORMATION TITLE -->
                <TextView
                    android:id="@+id/txtInfoTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="اطلاعات سرویس"
                    android:textColor="#202020"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- SERVICE INFORMATION GRID -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/infoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    app:cardBackgroundColor="#FFF0F3"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">


                        <!-- ROW 1 -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">


                            <!-- Experience -->

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="90dp"
                                android:layout_weight="1"
                                android:layout_margin="5dp"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:background="#FFFFFF"
                                android:padding="8dp">

                                <ImageView
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:src="@drawable/car_svgrepo_com"
                                    android:contentDescription="سابقه رانندگی" />

                                <TextView
                                    android:id="@+id/txtExperience"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="۶ سال"
                                    android:textColor="#CC0136"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="سابقه رانندگی"
                                    android:textColor="#777777"
                                    android:textSize="11sp" />

                            </LinearLayout>


                            <!-- Capacity -->

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="90dp"
                                android:layout_weight="1"
                                android:layout_margin="5dp"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:background="#FFFFFF"
                                android:padding="8dp">

                                <ImageView
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:src="@drawable/ic_users_group_two_rounded"
                                    android:contentDescription="ظرفیت سرویس" />

                                <TextView
                                    android:id="@+id/txtCapacity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="۴ نفر"
                                    android:textColor="#CC0136"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ظرفیت سرویس"
                                    android:textColor="#777777"
                                    android:textSize="11sp" />

                            </LinearLayout>

                        </LinearLayout>


                        <!-- ROW 2 -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">


                            <!-- Students -->

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="90dp"
                                android:layout_weight="1"
                                android:layout_margin="5dp"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:background="#FFFFFF"
                                android:padding="8dp">

                                <ImageView
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:src="@drawable/ic_users_group_two_rounded"
                                    android:contentDescription="دانش‌آموزان" />

                                <TextView
                                    android:id="@+id/txtStudents"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="۲ نفر"
                                    android:textColor="#CC0136"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="دانش‌آموزان فعلی"
                                    android:textColor="#777777"
                                    android:textSize="11sp" />

                            </LinearLayout>


                            <!-- Service Number -->

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="90dp"
                                android:layout_weight="1"
                                android:layout_margin="5dp"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:background="#FFFFFF"
                                android:padding="8dp">

                                <ImageView
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:src="@drawable/car_svgrepo_com"
                                    android:contentDescription="شماره سرویس" />

                                <TextView
                                    android:id="@+id/txtServiceNumber"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="۱۲"
                                    android:textColor="#CC0136"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="شماره سرویس"
                                    android:textColor="#777777"
                                    android:textSize="11sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ROUTE TITLE -->
                <TextView
                    android:id="@+id/txtRouteTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="مسیر سرویس"
                    android:textColor="#202020"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- ROUTE CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/routeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    app:cardBackgroundColor="#FFF0F3"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">


                        <!-- START POINT -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">


                            <ImageView
                                android:layout_width="27dp"
                                android:layout_height="27dp"
                                android:src="@drawable/ic_location"
                                android:contentDescription="نقطه شروع" />


                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="شروع مسیر"
                                    android:textColor="#888888"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/txtStartPoint"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="منطقه ۲ خرم‌آباد"
                                    android:textColor="#202020"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>


                        <!-- TIMELINE -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="27dp"
                                android:layout_height="match_parent" />

                            <View
                                android:layout_width="2dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="12dp"
                                android:background="#CC0136" />

                        </LinearLayout>


                        <!-- DESTINATION -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">


                            <ImageView
                                android:layout_width="27dp"
                                android:layout_height="27dp"
                                android:src="@drawable/ic_school"
                                android:contentDescription="مقصد" />


                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="مقصد"
                                    android:textColor="#888888"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/txtDestination"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="دبستان و دبیرستان فرزانگان"
                                    android:textColor="#202020"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>


                        <!-- ROUTE DESCRIPTION -->

                        <TextView
                            android:id="@+id/txtRouteDescript"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:padding="12dp"
                            android:background="#FFFFFF"
                            android:text="مسیر سرویس از منطقه ۲ به سمت مدرسه و محدوده‌های اطراف انجام می‌شود."
                            android:textColor="#666666"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!--     warning -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/warningCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    app:cardBackgroundColor="#F9EDC6"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="5dp">


                        <!-- ROUTE DESCRIPTION -->
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_gravity="center"
                            android:src="@drawable/warning_2_svgrepo_com"/>
                        <TextView
                            android:id="@+id/txtRouteDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:layout_marginTop="2dp"
                            android:padding="12dp"
                            android:text="هزینه سرویس بین شما و راننده (مدرسه) توافق میشود، این صرفا ابزار ردیابی ست ."
                            android:textColor="#666666"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ACTION BUTTONS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">


                    <!-- CALL -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCallDriver"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="تماس با راننده"
                        android:textColor="#CC0136"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_phone"
                        app:iconTint="#CC0136"
                        app:cornerRadius="14dp"
                        app:strokeColor="#CC0136"
                        app:strokeWidth="1dp"
                        app:backgroundTint="#FFFFFF" />


                    <!-- REQUEST -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestService"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="درخواست سرویس"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:iconTint="#FFFFFF"
                        app:cornerRadius="14dp"
                        app:backgroundTint="#CC0136" />

                </LinearLayout>


            </LinearLayout>

        </ScrollView>


        <!-- BOTTOM NAVIGATION -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            app:menu="@menu/bottom_nav_menu"
            app:labelVisibilityMode="labeled"
            app:itemIconTint="@color/primary_red"
            app:itemTextColor="@color/primary_red"
            app:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- menu -->
    <include
        android:id="@+id/drawerMenuLayout"
        layout="@layout/drawer_menu"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="right" />

</androidx.drawerlayout.widget.DrawerLayout>

