<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4FBFC"
        android:layoutDirection="rtl">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <include
            android:id="@+id/headerLayout"
            layout="@layout/layout_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@+id/headerLayout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="30dp">




                <!-- title -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="مدرسه شما در لیست نیست؟"
                    android:textColor="#123B4A"
                    android:layout_marginTop="16dp"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="اطلاعات مدرسه را وارد کنید تا درخواست شما بررسی شود."
                    android:textColor="#52717A"
                    android:textSize="13sp"/>




                <!-- فرم -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E0ECEE"
                    app:strokeWidth="1dp"
                    android:layout_marginTop="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">


                        <!-- نام مدرسه -->

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="نام مدرسه *"
                            android:textColor="#123B4A"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <EditText
                            android:id="@+id/edtSchoolName"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/editbox_background"
                            android:hint="مثلاً دبیرستان شهید بهشتی"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="#123B4A"
                            android:textColorHint="#9AAEB3"
                            android:textSize="13sp"
                            android:singleLine="true"/>


                        <!-- شهر -->

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="شهر *"
                            android:textColor="#123B4A"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <EditText
                            android:id="@+id/edtCity"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/editbox_background"
                            android:hint="مثلاً تهران"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="#123B4A"
                            android:textColorHint="#9AAEB3"
                            android:textSize="13sp"
                            android:singleLine="true"/>


                        <!-- منطقه -->

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="منطقه / ناحیه"
                            android:textColor="#123B4A"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <EditText
                            android:id="@+id/edtDistrict"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/editbox_background"
                            android:hint="مثلاً منطقه ۶"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="#123B4A"
                            android:textColorHint="#9AAEB3"
                            android:textSize="13sp"
                            android:singleLine="true"/>


                        <!-- شماره تماس -->

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="شماره تماس مدرسه"
                            android:textColor="#123B4A"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <EditText
                            android:id="@+id/edtSchoolPhone"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/editbox_background"
                            android:hint="مثلاً 02112345678"
                            android:inputType="phone"
                            android:maxLength="11"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="#123B4A"
                            android:textColorHint="#9AAEB3"
                            android:textSize="13sp"
                            android:singleLine="true"
                            android:layoutDirection="ltr"/>


                        <!-- آدرس -->

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="آدرس کامل مدرسه *"
                            android:textColor="#123B4A"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <EditText
                            android:id="@+id/edtSchoolAddress"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/editbox_background"
                            android:gravity="top|right"
                            android:hint="استان، شهر، خیابان، کوچه و پلاک..."
                            android:padding="14dp"
                            android:textColor="#123B4A"
                            android:textColorHint="#9AAEB3"
                            android:textSize="13sp"
                            android:inputType="textMultiLine"
                            android:maxLines="4"/>


                        <!-- توضیحات -->

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="توضیحات اضافی"
                            android:textColor="#123B4A"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <EditText
                            android:id="@+id/edtDescription"
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/editbox_background"
                            android:gravity="top|right"
                            android:hint="اگر توضیح دیگری دارید اینجا بنویسید..."
                            android:padding="14dp"
                            android:textColor="#123B4A"
                            android:textColorHint="#9AAEB3"
                            android:textSize="13sp"
                            android:inputType="textMultiLine"
                            android:maxLines="4"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- دکمه -->

                <Button
                    android:id="@+id/btnSubmitSchool"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#CC0136"
                    android:text="ثبت درخواست"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"/>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="اطلاعات شما پس از بررسی ثبت خواهد شد."
                    android:textColor="#8AA0A5"
                    android:textSize="11sp"/>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- menu -->
    <include
        android:id="@+id/drawerMenuLayout"
        layout="@layout/drawer_menu"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="right" />
</androidx.drawerlayout.widget.DrawerLayout>


