<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FBFC"
    android:layoutDirection="rtl">

    <!-- HEADER -->
    <include
        android:id="@+id/headerLayout"
        layout="@layout/driver_layout_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <!-- Notification Summary -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNotificationSummary"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="#E2EEF0"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:background="@drawable/bg_bus_icon"
                android:src="@drawable/ic_notifications"
                app:tint="@color/driver_main"
                android:contentDescription="اعلان‌ها" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="13dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اعلان‌های اخیر"
                    android:textColor="#123B4A"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/txtUnreadCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="۳ اعلان خوانده نشده"
                    android:textColor="#52717A"
                    android:textSize="12sp" />

            </LinearLayout>



        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- Section -->
    <TextView
        android:id="@+id/txtSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:text="اعلان‌های امروز"
        android:textColor="#123B4A"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/cardNotificationSummary"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- Notifications -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerNotifications"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtSectionTitle"
        app:layout_constraintBottom_toTopOf="@id/driverBottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================= Bottom Navigation ================= -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/driverBottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:menu="@menu/driver_bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/driver_main"
        app:itemTextColor="@color/driver_main"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- menu -->
<include
android:id="@+id/drawerMenuLayout"
layout="@layout/driver_drawer_menu"
android:layout_width="300dp"
android:layout_height="match_parent"
android:layout_gravity="right" />
    </androidx.drawerlayout.widget.DrawerLayout>