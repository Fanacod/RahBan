<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FBFC"
    android:layoutDirection="rtl">

    <!-- ================================================= -->
    <!-- MAP CONTAINER & OVERLAYS -->
    <!-- ================================================= -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ۱. نقشه نشان در پایین‌ترین لایه (پس‌زمینه) -->
        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- لایه رسم مسیر سفارشی (اگر نیاز دارید روی نقشه باشد) -->
        <com.example.rahban3.LiveRouteView
            android:id="@+id/liveRouteView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:ignore="MissingClass" />

        <!-- ================================================= -->
        <!-- TOP BAR (شناور روی نقشه) -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="24dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layoutDirection="ltr"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- دکمه بازگشت -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_map_white_pill"
                android:clickable="true"
                android:contentDescription="بازگشت"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_left_arrow"
                app:tint="@color/driver_main" />

            <!-- وضعیت مسیر -->
            <TextView
                android:id="@+id/txtRouteStatus"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_map_white_pill"
                android:gravity="center"
                android:text="در مسیر خانه"
                android:textColor="#52717A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- مدرسه -->
            <TextView
                android:id="@+id/txtSchool"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:gravity="center"
                android:background="@drawable/bg_tab_selected"
                android:text="مدرسه"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ================================================= -->
        <!-- ETA (شناور روی نقشه) -->
        <!-- ================================================= -->
        <TextView
            android:id="@+id/txtEta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="85dp"
            android:background="@drawable/bg_map_green_pill"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="ETA: ۷ دقیقه"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- ================================================= -->
        <!-- DRIVER CARD (شناور در پایین صفحه) -->
        <!-- ================================================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/driverBottomCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="22dp"
            app:cardElevation="8dp"
            app:strokeColor="#E1ECEE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- DRIVER INFO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- تصویر راننده -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgDriverAvatar"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/person_driver"
                        android:scaleType="centerCrop"
                        android:contentDescription="تصویر راننده"
                        app:shapeAppearanceOverlay="@style/CircleImageView" />

                    <!-- مشخصات -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtDriverName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="مهدی رضایی"
                            android:textColor="#123B4A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtServiceNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="سرویس شماره ۱۲"
                            android:textColor="#52717A"
                            android:textSize="12sp" />

                        <!-- وضعیت حرکت -->
                        <TextView
                            android:id="@+id/txtMovingStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="در حال حرکت به سمت مقصد بعدی"
                            android:textColor="@color/driver_main"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- امتیاز با آیکون -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtDriverRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:text="۴.۸"
                            android:textColor="#52717A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_star"
                            app:tint="#F2B544"
                            android:contentDescription="امتیاز" />
                    </LinearLayout>

                </LinearLayout>

                <!-- DIVIDER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="#EDF2F3" />

                <!-- ROUTE INFO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- مبدأ -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="مبدأ"
                            android:textColor="#9AAEB3"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/txtStartPoint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="منطقه ۶"
                            android:textColor="#123B4A"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- آیکون مسیر -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="مسیر"
                        android:src="@drawable/ic_route"
                        app:tint="@color/driver_main" />

                    <!-- مقصد -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="مقصد"
                            android:textColor="#9AAEB3"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/txtDestination"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="مدرسه"
                            android:textColor="#123B4A"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
