<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4FBFC"
        android:layoutDirection="rtl">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <include
            android:id="@+id/headerLayout"
            layout="@layout/layout_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================================= -->
        <!-- MAIN SCROLL -->
        <!-- ================================================= -->

        <ScrollView
            android:id="@+id/scrollPayment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintBottom_toTopOf="@id/paymentBottomArea"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="20dp">


                <!-- ================================================= -->
                <!-- SUCCESS / CONFIRMATION -->
                <!-- ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/statusCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#F2DCE2"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="22dp">


                        <!-- آیکون موفقیت -->

                        <FrameLayout
                            android:id="@+id/successIconContainer"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:background="@drawable/bg_confirmed_badge">

                            <ImageView
                                android:id="@+id/imgSuccessIcon"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_gravity="center"
                                android:contentDescription="تأیید درخواست"
                                android:src="@drawable/ic_check_circle" />

                        </FrameLayout>


                        <!-- عنوان -->

                        <TextView
                            android:id="@+id/txtSuccessTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:gravity="center"
                            android:text="راننده درخواست شما را تأیید کرد"
                            android:textColor="#123B4A"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />


                        <!-- توضیح -->

                        <TextView
                            android:id="@+id/txtSuccessDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"
                            android:text="برای فعال‌سازی سرویس، اشتراک سالانه راهبان را فعال کنید."
                            android:textColor="#52717A"
                            android:textSize="13sp" />


                        <!-- وضعیت -->

                        <TextView
                            android:id="@+id/txtConfirmed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:background="@drawable/bg_confirmed_badge"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp"
                            android:text="درخواست تأیید شده"
                            android:textColor="#cc0136"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================================================= -->
                <!-- STUDENT INFORMATION -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/txtStudentSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="اطلاعات دانش‌آموز"
                    android:textColor="#123B4A"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/studentCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E3EEF0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">


                        <!-- نام دانش آموز -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/txtDriverAvatar"
                                android:layout_width="65dp"
                                android:layout_height="65dp"
                                android:src="@drawable/ic_student"
                                android:scaleType="centerCrop"
                                android:contentDescription="تصویر راننده"
                                app:shapeAppearanceOverlay="@style/CircleImageView" />


                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="نام دانش‌آموز"
                                    android:textColor="#789096"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/txtStudentName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="علی رضایی"
                                    android:textColor="#123B4A"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>


                        <!-- Divider -->

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="14dp"
                            android:background="#EEF3F4" />


                        <!-- پایه و جنسیت -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">


                            <!-- پایه -->

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="پایه تحصیلی"
                                    android:textColor="#789096"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/txtStudentGrade"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="ششم ابتدایی"
                                    android:textColor="#123B4A"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>


                            <!-- جنسیت -->

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="جنسیت"
                                    android:textColor="#789096"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/txtStudentGender"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="پسر"
                                    android:textColor="#123B4A"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>


                        <!-- Divider -->

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="14dp"
                            android:background="#EEF3F4" />


                        <!-- آدرس -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="آدرس منزل"
                                android:src="@drawable/ic_location"
                                />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="آدرس منزل"
                                    android:textColor="#789096"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/txtStudentAddress"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:text="تهران، منطقه ۶، خیابان ولیعصر..."
                                    android:textColor="#123B4A"
                                    android:textSize="13sp" />

                            </LinearLayout>

                        </LinearLayout>


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================================================= -->
                <!-- DRIVER INFORMATION -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/txtDriverSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="اطلاعات راننده و سرویس"
                    android:textColor="#123B4A"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/driverCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E3EEF0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">


                        <!-- راننده -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">


                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/imgDriverIcon"
                                android:layout_width="65dp"
                                android:layout_height="65dp"
                                android:src="@drawable/person_driver"
                                android:scaleType="centerCrop"
                                android:contentDescription="تصویر راننده"
                                app:shapeAppearanceOverlay="@style/CircleImageView" />


                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtDriverName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="مهدی رضایی"
                                    android:textColor="#123B4A"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtDriverRating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="امتیاز ۴.۸ از ۵"
                                    android:textColor="#789096"
                                    android:textSize="12sp" />

                            </LinearLayout>


                            <TextView
                                android:id="@+id/txtDriverConfirmed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:text="تأیید شده"
                                android:background="@drawable/bg_confirmed_badge"
                                android:textColor="#cc0136"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <!-- Divider -->

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="15dp"
                            android:layout_marginBottom="15dp"
                            android:background="#EEF3F4" />


                        <!-- اطلاعات سرویس -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">


                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="شماره سرویس"
                                    android:textColor="#789096"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/txtServiceNumber"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="سرویس شماره ۱۲"
                                    android:textColor="#123B4A"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                            </LinearLayout>


                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="ظرفیت"
                                    android:textColor="#789096"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/txtCapacity"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="۱۴ نفر"
                                    android:textColor="#123B4A"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>


                        <!-- مسیر -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:contentDescription="مسیر"
                                android:src="@drawable/adventure_journey_location_svgrepo_com" />

                            <TextView
                                android:id="@+id/txtRoute"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="منطقه ۶ → مدرسه"
                                android:textColor="#123B4A"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================================================= -->
                <!-- SUBSCRIPTION -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/txtSubscriptionSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="فعال‌سازی اشتراک"
                    android:textColor="#123B4A"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/subscriptionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#F1DDE3"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">


                        <!-- عنوان -->

                        <TextView
                            android:id="@+id/txtSubscriptionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="اشتراک سالانه راهبان"
                            android:textColor="#123B4A"
                            android:textSize="17sp"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/txtSubscriptionDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="برای استفاده از امکانات کامل پلتفرم راهبان"
                            android:textColor="#52717A"
                            android:textSize="12sp" />


                        <!-- قیمت -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_request_number"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/txtPriceLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="هزینه اشتراک سالانه"
                                android:textColor="#52717A"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="۳۰۰,۰۰۰ تومان"
                                android:textColor="#CC0136"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <!-- امکانات -->

                        <TextView
                            android:id="@+id/txtFeaturesTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="امکاناتی که دریافت می‌کنید"
                            android:textColor="#123B4A"
                            android:textSize="14sp"
                            android:textStyle="bold" />


                        <!-- ویژگی 1 -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:contentDescription="ویژگی"
                                android:src="@drawable/ic_check_circle" />

                            <TextView
                                android:id="@+id/txtFeatureTracking"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_weight="1"
                                android:text="ردیابی لحظه‌ای سرویس"
                                android:textColor="#123B4A"
                                android:textSize="13sp" />

                        </LinearLayout>


                        <!-- ویژگی 2 -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:contentDescription="ویژگی"
                                android:src="@drawable/ic_check_circle" />

                            <TextView
                                android:id="@+id/txtFeatureNotification"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_weight="1"
                                android:text="اعلان ورود و خروج دانش‌آموز"
                                android:textColor="#123B4A"
                                android:textSize="13sp" />

                        </LinearLayout>


                        <!-- ویژگی 3 -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:contentDescription="ویژگی"
                                android:src="@drawable/ic_check_circle" />

                            <TextView
                                android:id="@+id/txtFeatureSupport"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_weight="1"
                                android:text="تماس و پشتیبانی درون برنامه"
                                android:textColor="#123B4A"
                                android:textSize="13sp" />

                        </LinearLayout>


                        <!-- ویژگی 4 -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:contentDescription="ویژگی"
                                android:src="@drawable/ic_check_circle" />

                            <TextView
                                android:id="@+id/txtFeatureUnlimited"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_weight="1"
                                android:text="استفاده بدون محدودیت در طول اشتراک"
                                android:textColor="#123B4A"
                                android:textSize="13sp" />

                        </LinearLayout>


                        <!-- توضیح هزینه -->

                        <TextView
                            android:id="@+id/txtPaymentNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="17dp"
                            android:background="#F7FAFA"
                            android:lineSpacingExtra="2dp"
                            android:padding="12dp"
                            android:text="این مبلغ فقط بابت استفاده از پلتفرم راهبان است و هزینه سرویس حمل‌ونقل به‌صورت جداگانه محاسبه می‌شود."
                            android:textColor="#52717A"
                            android:textSize="11sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- فاصله انتهایی -->

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="18dp" />

            </LinearLayout>

        </ScrollView>


        <!-- ================================================= -->
        <!-- PAYMENT ACTION -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/paymentBottomArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPayAndActivate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="پرداخت و فعال‌سازی سرویس"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                app:backgroundTint="#34CC01"
                app:cornerRadius="15dp"
                app:icon="@drawable/ic_lock"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF" />


            <TextView
                android:id="@+id/txtSecurePayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="پرداخت امن و رمزنگاری‌شده"
                android:textColor="#8AA1A6"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- BOTTOM NAVIGATION -->
        <!-- ================================================= -->

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:elevation="12dp"
            app:menu="@menu/bottom_nav_menu"
            app:labelVisibilityMode="labeled"
            app:itemIconTint="@color/primary_red"
            app:itemTextColor="@color/primary_red"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- menu -->
    <include
        android:id="@+id/drawerMenuLayout"
        layout="@layout/drawer_menu"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="right" />
</androidx.drawerlayout.widget.DrawerLayout>
