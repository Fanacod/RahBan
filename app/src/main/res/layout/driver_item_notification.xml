<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notificationCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2EEF0"
    android:layoutDirection="rtl"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/notificationContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="15dp"
        android:gravity="center_vertical">

        <!-- Icon -->
        <ImageView
            android:id="@+id/imgNotification"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="11dp"
            android:background="@drawable/bg_bus_icon"
            android:src="@drawable/ic_notifications"
            app:tint="@color/driver_main"
            android:contentDescription="اعلان" />


        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtNotificationTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="درخواست جدید سرویس"
                    android:textColor="#123B4A"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/txtNotificationTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="۱۰ دقیقه پیش"
                    android:textColor="#9AAEB3"
                    android:textSize="10sp" />

            </LinearLayout>


            <TextView
                android:id="@+id/txtNotificationMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="درخواست سرویس جدیدی از طرف والد ثبت شده است."
                android:textColor="#52717A"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />


            <TextView
                android:id="@+id/txtNotificationType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_bus_icon"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="درخواست سرویس"
                android:textColor="@color/driver_main"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>


        <!-- Unread indicator -->
        <View
            android:id="@+id/viewUnread"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_avatar" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>